# Alohomora! Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual local configuration.
# Never commit real credentials or private keys to git.

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Frontend Origin for CORS (supports credentials / cookies)
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:your_mysql_password@localhost:3306/alohomora_db"

# Session & Authentication Secrets
# Generate a strong random 64-character secret in production
SESSION_SECRET="your-development-session-secret-change-in-production-min-32-chars"
SESSION_COOKIE_NAME="alohomora_session"
SESSION_MAX_AGE_DAYS=7

# Groq AI Assistant (Professor Who?)
# Obtain an API key from https://console.groq.com
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"

# Optional Email Dispatch (SMTP)
# When left empty, Alohomora! runs in development mode and logs 6-digit codes to the server terminal.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Alohomora! Keykeeper <no-reply@alohomora.edu.bd>"

# File Upload Configuration
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_DIR="./uploads"

